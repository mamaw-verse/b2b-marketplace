APP_NAME="1Halal Store"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

# SEO: force noindex + Disallow: / even in production (non-production is always noindex)
SEO_FORCE_NOINDEX=false
# Serve /sitemap.xml (and child sitemaps) and advertise it in robots.txt
SEO_SITEMAP_ENABLED=true
# Block AI model-training crawlers (GPTBot, ClaudeBot, CCBot, ...). Search/answer bots stay allowed.
SEO_BLOCK_AI_TRAINING=true
# Block Google-Extended, which gates Gemini training and Gemini answer grounding together (false = allowed, so Gemini can cite the site)
SEO_BLOCK_AI_GROUNDING=false
# hreflang x-default: country code of the portal used as the global default (e.g. PH); empty omits x-default.
# Cross-country hreflang is only emitted when PORTAL_xx_URL is set for this instance and at least one other portal.
SEO_HREFLANG_X_DEFAULT_COUNTRY=
# Browser chrome colour (<meta name="theme-color"> and the web manifest); defaults to --hs-green-600
SEO_THEME_COLOR="#00312B"
# Seconds a cached sitemap / llms.txt may live if no model event invalidates it first
SEO_SITEMAP_CACHE_TTL=3600
# One-sentence description of the marketplace, shared by Organization/WebSite JSON-LD, llms.txt and the web manifest.
# Empty uses the translated default. Paste the same text into each social profile's bio.
SEO_ENTITY_DESCRIPTION=
# Structured data (Organization): comma-separated public http(s) social profile URLs for sameAs
SEO_SOCIAL_PROFILES=
# Structured data (Organization): public support email; contactPoint is omitted when empty
SEO_CONTACT_EMAIL=

# Country served by this marketplace instance (ISO 3166-1 alpha-2)
MARKETPLACE_INSTANCE_COUNTRY=PH

# Subscription payment method for this instance: 'dlt' (DLT-hosted checkout, default)
# or 'manual' (merchant submits reference number + receipt, admin activates manually).
# Philippine instances use 'dlt'. Other country instances without DLT use 'manual'.
MARKETPLACE_PAYMENT_METHOD=dlt

# Set to true to require a paid subscription before sellers can list products.
# When false (default) the marketplace is free — no subscription or trial is enforced.
# Flip to true and configure subscription plans when you are ready to charge sellers.
MARKETPLACE_SUBSCRIPTIONS_ENABLED=false
# Fallback commission rate (0.10 = 10%); the admin payout setting overrides it
MARKETPLACE_COMMISSION_RATE=0.10

TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_here

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (PostgreSQL + PostGIS)
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit for local)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS="admin@example.com"

# Mail (Amazon SES for staging/production)
# MAIL_MAILER=ses
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=ap-southeast-1
# SES_CONFIGURATION_SET=
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_ADMIN_ADDRESS="ops@yourdomain.com"

# Object Storage (Minio / S3)
# Local uses Minio via AWS_ENDPOINT. In staging/production against real AWS,
# leave AWS_ENDPOINT / AWS_URL / AWS_TEMPORARY_URL empty and set the real
# bucket + region (same IAM credentials as SES when using instance roles).
AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=halal-b2b
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/halal-b2b
AWS_TEMPORARY_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Product videos are disabled until video upload and playback QA is complete.
MARKETPLACE_PRODUCT_VIDEO_ENABLED=false
MARKETPLACE_PRODUCT_VIDEO_MAX_KB=51200
# Local-only: isolate test uploads so they can be purged from a live bucket.
# MARKETPLACE_VIDEO_STORAGE_PREFIX=test-media/videos

# Seller staff is disabled until the environment has passed staff feature QA.
MARKETPLACE_STAFF_ENABLED=false
MARKETPLACE_MAX_STAFF_PER_SHOP=2

# Product share bar is disabled until storefront share testing is complete.
MARKETPLACE_PRODUCT_SHARE_ENABLED=false
MARKETPLACE_SHARE_PUBLIC_MIN=5
MARKETPLACE_SHARE_DEDUPE_MINUTES=10

# Search (Scout) — native Postgres FTS via the `pgsql` driver by default.
# Flip back to Typesense later with SCOUT_DRIVER=typesense plus
# `sail up --profile search` and `sail artisan scout:import`.
SCOUT_DRIVER=pgsql
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=xyz

# ClamAV (Antivirus) — optional. Set CLAMAV_ENABLED=true in production
# where the clamav service is running (`sail up --profile scanning`).
# When false, uploads are marked clean immediately and no scan job runs.
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Reverb (WebSocket)
REVERB_APP_ID=halal-b2b-local
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# DLT Payment Gateway (Phase 3)
DLT_BASE_URL=https://checkout.dxp.dtic.com.ph
DLT_CLIENT_ID=
DLT_CLIENT_SECRET=
DLT_MERCHANT_ACCOUNT_ID=
DLT_SERVICE_CODE=APN-COLLECTION

# Geocoding (address → lat/lng)
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=

# Google Analytics
GOOGLE_ANALYTICS_ID=
GA4_PROPERTY_ID=
GOOGLE_ANALYTICS_CREDENTIALS=

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sail
WWWGROUP=1000
WWWUSER=1000
